# يُضاف لمستخدم sysadmin (crontab -e). لا يحتاج sudo؛ يكفي أنه في مجموعة docker.
# مرة واحدة قبله: mkdir -p ~/security/ofoq
# فحص Trivy الأسبوعي للصورة مع SBOM، الأحد 04:17 بتوقيت عمّان (E26.11).
# افحص توقيت المضيف أولاً (timedatectl): إن كان UTC وعمّان UTC+3 فالسطر يصبح 17 1 * * 0.
CRON_TZ=Asia/Amman
17 4 * * 0 bash /home/sysadmin/ofoq/scripts/security/trivy-scan.sh >> $HOME/security/ofoq/scan.log 2>&1
