# يُضاف لمستخدم sysadmin (crontab -e). لا يحتاج sudo؛ يكفي أنه في مجموعة docker.
# اللقطة اليومية داخل الحاوية 02:30 بتوقيت عمّان، فالمجمّع بعدها بعشرين دقيقة.
# افحص توقيت المضيف أولاً (timedatectl): إن كان UTC وعمّان UTC+3 فالسطر يصبح 50 23 * * *.
CRON_TZ=Asia/Amman
50 2 * * * bash /home/sysadmin/ofoq/scripts/backup/collect.sh >> $HOME/backups/ofoq/collect.log 2>&1

# تمرين الاستعادة الشهري: أول سبت 03:30. (حقلا اليوم والشهر في cron يُجمعان بـ «أو»، فالشرط في الأمر)
30 3 * * 6 [ "$(date +\%d)" -le 07 ] && bash /home/sysadmin/ofoq/scripts/backup/drill.sh >> $HOME/backups/ofoq/drill.log 2>&1
